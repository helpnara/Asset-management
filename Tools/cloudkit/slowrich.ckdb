DEFINE SCHEMA

    RECORD TYPE CD_Account (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_institution STRING,
        CD_institution_ckAsset ASSET,
        CD_kindRaw STRING,
        CD_kindRaw_ckAsset ASSET,
        CD_isArchived INT64,
        CD_sortIndex INT64,
        CD_createdAt TIMESTAMP,
        CD_annualContributionMinor INT64,
        CD_annualLimitMinor INT64,
        CD_expectedReturnBP INT64,
        CD_maturesOn TIMESTAMP,
        CD_ownerID STRING,
        CD_ownerID_ckAsset ASSET,
        CD_owner STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_CashEvent (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_date TIMESTAMP,
        CD_label STRING,
        CD_label_ckAsset ASSET,
        CD_amountMinor INT64,
        CD_isAlreadyReflected INT64,
        CD_note STRING,
        CD_note_ckAsset ASSET,
        CD_sortIndex INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_ChangeLog (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_at TIMESTAMP,
        CD_actor STRING,
        CD_actor_ckAsset ASSET,
        CD_kindRaw STRING,
        CD_kindRaw_ckAsset ASSET,
        CD_subject STRING,
        CD_subject_ckAsset ASSET,
        CD_summary STRING,
        CD_summary_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_FamilyTarget (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_dimensionRaw STRING,
        CD_dimensionRaw_ckAsset ASSET,
        CD_key STRING,
        CD_key_ckAsset ASSET,
        CD_targetBP INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Holding (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_assetClassRaw STRING,
        CD_assetClassRaw_ckAsset ASSET,
        CD_instrumentTypeRaw STRING,
        CD_instrumentTypeRaw_ckAsset ASSET,
        CD_listingCountryCode STRING,
        CD_listingCountryCode_ckAsset ASSET,
        CD_statusRaw STRING,
        CD_statusRaw_ckAsset ASSET,
        CD_cadenceRaw STRING,
        CD_cadenceRaw_ckAsset ASSET,
        CD_valueMinor INT64,
        CD_lastEnteredValueMinor INT64,
        CD_lastEnteredAt TIMESTAMP,
        CD_note STRING,
        CD_note_ckAsset ASSET,
        CD_targetWeightBP INT64,
        CD_sortIndex INT64,
        CD_createdAt TIMESTAMP,
        CD_account STRING,
        CD_accountID STRING,
        CD_accountID_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_IncomeStream (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_label STRING,
        CD_label_ckAsset ASSET,
        CD_monthlyAmountMinor INT64,
        CD_startYear INT64,
        CD_endYear INT64,
        CD_isInflationLinked INT64,
        CD_sortIndex INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Member (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_roleNote STRING,
        CD_roleNote_ckAsset ASSET,
        CD_birthYear INT64,
        CD_birthMonth INT64,
        CD_taxResidencyRaw STRING,
        CD_taxResidencyRaw_ckAsset ASSET,
        CD_targetRetirementAge INT64,
        CD_monthlyContributionMinor INT64,
        CD_employerMatchMinor INT64,
        CD_note STRING,
        CD_note_ckAsset ASSET,
        CD_colorIndex INT64,
        CD_sortIndex INT64,
        CD_createdAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Plan (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_title STRING,
        CD_title_ckAsset ASSET,
        CD_startYear INT64,
        CD_startedOn TIMESTAMP,
        CD_asOfNote STRING,
        CD_asOfNote_ckAsset ASSET,
        CD_declaration STRING,
        CD_declaration_ckAsset ASSET,
        CD_retirementYear INT64,
        CD_monthlyContributionMinor INT64,
        CD_annualReturnBP INT64,
        CD_contributionGrowthBP INT64,
        CD_inflationBP INT64,
        CD_lowYieldReturnBP INT64,
        CD_realEstateReturnBP INT64,
        CD_targetAmountMinor INT64,
        CD_monthlySpendingMinor INT64,
        CD_withdrawalRateBP INT64,
        CD_monthlyIncomeMinor INT64,
        CD_savingsFloorBP INT64,
        CD_illiquidCapBP INT64,
        CD_usTargetBP INT64,
        CD_mixToleranceBP INT64,
        CD_driftToleranceBP INT64,
        CD_driftRelativeBP INT64,
        CD_usesMemberContributions INT64,
        CD_horizonYear INT64,
        CD_createdAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Principle (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_order INT64,
        CD_title STRING,
        CD_title_ckAsset ASSET,
        CD_detail STRING,
        CD_detail_ckAsset ASSET,
        CD_reviewNote STRING,
        CD_reviewNote_ckAsset ASSET,
        CD_createdAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_ReviewSession (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_weekAnchor TIMESTAMP,
        CD_startedAt TIMESTAMP,
        CD_completedAt TIMESTAMP,
        CD_enteredCount INT64,
        CD_totalCount INT64,
        CD_isTotalOnly INT64,
        CD_totalValueMinor INT64,
        CD_previousTotalValueMinor INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Scenario (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_monthlyMinor INT64,
        CD_retirementYear INT64,
        CD_returnBP INT64,
        CD_volatilityBP INT64,
        CD_projectedMinor INT64,
        CD_createdAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Snapshot (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_weekAnchor TIMESTAMP,
        CD_netWorthMinor INT64,
        CD_investableMinor INT64,
        CD_liabilitiesMinor INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_SnapshotLine (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_memberID STRING,
        CD_memberID_ckAsset ASSET,
        CD_memberName STRING,
        CD_memberName_ckAsset ASSET,
        CD_valueMinor INT64,
        CD_sortIndex INT64,
        CD_snapshot STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_TodoItem (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_title STRING,
        CD_title_ckAsset ASSET,
        CD_detail STRING,
        CD_detail_ckAsset ASSET,
        CD_categoryRaw STRING,
        CD_categoryRaw_ckAsset ASSET,
        CD_dueDate TIMESTAMP,
        CD_isDone INT64,
        CD_repeatsYearly INT64,
        CD_completedAt TIMESTAMP,
        CD_sortIndex INT64,
        CD_createdAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_UserMilestone (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_year INT64,
        CD_label STRING,
        CD_label_ckAsset ASSET,
        CD_note STRING,
        CD_note_ckAsset ASSET,
        CD_sortIndex INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

